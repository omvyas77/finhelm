# Generation model (Claude)
ANTHROPIC_API_KEY=sk-ant-...

# Eval judge — MUST be a different model family than the generator.
# Same-family judging produces self-preference bias.
GOOGLE_API_KEY=...

# Required by SEC EDGAR. Must be descriptive; a generic UA returns 403.
SEC_USER_AGENT=Om Vyas omvyas2808@gmail.com

# pgvector (docker-compose service)
# Read by stores/pgvector_store.py. Compose overrides the host to `postgres`.
FINHELM_PG_DSN=postgresql://finhelm:finhelm@localhost:5432/finhelm

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
MLFLOW_TRACKING_URI=http://localhost:5000

# Owner of mlflow.db on the host. The mlflow container writes to it through a bind mount,
# so it has to run as that uid; the defaults match macOS (501:20). `id -u` / `id -g`.
FINHELM_UID=501
FINHELM_GID=20
