{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "finhelm-ui",
      "runtimeExecutable": ".venv/bin/streamlit",
      "runtimeArgs": ["run", "app.py", "--server.port", "8501", "--server.headless", "true"],
      "port": 8501
    },
    {
      "name": "finhelm-api",
      "runtimeExecutable": ".venv/bin/uvicorn",
      "runtimeArgs": ["src.finhelm.api:app", "--host", "0.0.0.0", "--port", "8000"],
      "port": 8000
    }
  ]
}
